# Copy to .env.release.local and fill in before npm run release.
# These values are baked into app/.env.local inside the exhibition zip.
# .env.release.local is gitignored — never commit secrets.

RECEIPT_ARCHIVE_INSTALLATION_ID=serpentine-2026
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=future-art-ecosystem
R2_RECEIPT_PREFIX=receipts

# Set to 0 to disable cloud upload on the kiosk
# RECEIPT_ARCHIVE_CLOUD=0
