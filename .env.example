# Kiosk dev — copy to .env.local (not for Vercel viewer)

NEXT_PUBLIC_FAE_INSTALLATION_MODE=1
FAE_DATA_SOURCE=local
NEXT_PUBLIC_RECEIPT_VIEW_BASE_URL=https://YOUR-PROJECT.vercel.app
